tint = Color(0.9, 0.6, 0.65, 1)
dialogues = {"manana": PackedStringArray("¡Buenos dias! ¿Jugamos luego?", "Toby me deja acariciarlo."), "dia": PackedStringArray("¿Me enseñas tu huerto?", "Las gallinas me siguen a todas partes."), "tarde": PackedStringArray("Juego en la plaza hasta cenar.", "¿Has visto las nubes hoy?"), "noche": PackedStringArray("Mama me llama. ¡Adios!", "Mañana te cuento un secreto."), "lluvia": PackedStringArray("¡Charcos! Bueno, con cuidado.", "La lluvia suena a cancion."), "fiesta": PackedStringArray("¡FESTIVAL! ¡Hay fiesta en la plaza!", "¡Que viva la fiesta!")}
