dialogues = {"manana": PackedStringArray("¿Tus animales comieron bien?", "La prevencion es la mejor medicina."), "dia": PackedStringArray("Si alguno enferma, traemelo: 5 monedas.", "Un animal contento produce mas."), "tarde": PackedStringArray("Reviso el valle al atardecer.", "¿Todo bien en tu granja?"), "noche": PackedStringArray("Ya guardo el maletin.", "Descansa."), "lluvia": PackedStringArray("Con humedad vigila los cascos.", "Dia de establo."), "fiesta": PackedStringArray("Hasta los animales notan la fiesta.", "Hoy curo gratis... es broma. Casi.")}
