; Engine configuration file.
; Nuestra Vida en el Campo — Godot 4 clásica (GDScript). MVP semana completa primavera.

config_version=5

[application]

config/name="Nuestra Vida en el Campo"
config/description="Simulador de vida rural cozy en el campo de Azerbaiyan. MVP: semana completa en primavera."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

TimeSystem="*res://scripts/systems/time_system.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
InventorySystem="*res://scripts/systems/inventory_system.gd"
AnimalSystem="*res://scripts/systems/animal_system.gd"
FarmingSystem="*res://scripts/systems/farming_system.gd"
WeatherSystem="*res://scripts/systems/weather_system.gd"
AudioSystem="*res://scripts/systems/audio_system.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.53, 0.75, 0.95, 1)
textures/vram_compression/import_etc2_astc=true
